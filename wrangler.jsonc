{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "w-form-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wform-db",
      "database_id": "63f4f918-01a7-4038-8d06-6d821c4d56f3"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "WA_GRAPH_VERSION": "v27.0",
    "WA_BUSINESS_ACCOUNT_ID": "390231060836292",
    "WA_PHONE_NUMBER_ID": "342896612248107",
    "META_APP_ID": "1013953047058135",
    "ACCESS_TEAM_DOMAIN": "edougan.cloudflareaccess.com",
    "ACCESS_AUD": "2a5fafd1222844f403366be52a90acd2d9dee88ba0c3df7c42ad632f940fe809"
  }
}
